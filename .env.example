GROQ_API_KEY=your_key_here

# --- optional ---
# Model routing (see llmops/router.py). Two tiers, picked per call:
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GROQ_MODEL_STRONG=llama-3.3-70b-versatile     (GROQ_MODEL still works as an alias)
# ROUTING_MODE=auto            # auto | fast | strong  (fast/strong force ONE model, for A/B baselines)

# Resilience
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=2

# Telemetry
# LLM_LOG=0                    # disable logs/llm_calls.jsonl

# Test modes
# INTERVIEW_TEXT_MODE=1
# INTERVIEW_DRY_RUN=1
# INTERVIEW_TTS_VOICE=en-US-GuyNeural
